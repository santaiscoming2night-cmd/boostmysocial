# Copy to .env (git-ignored), then fill in your Supabase project credentials.
# On your hosting provider, set these same variables in project settings.
# All variables are server-only. Do not add NEXT_PUBLIC_ prefixes.

# Supabase Dashboard → Project Settings → API / API Keys
SUPABASE_URL=
# Anon / publishable key; used with the user's session so RLS still applies.
SUPABASE_ANON_KEY=
# Service-role / secret key; bypasses RLS. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, without a trailing slash. Used server-side for auth redirects
# and the API docs endpoint. Set to your HTTPS domain in production.
SITE_URL=http://localhost:3000
