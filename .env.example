# =============================================================================
# Boost My Social — environment variables
#
# Local development:  cp .env.example .env.local  (then fill in the values)
# Vercel:             Project → Settings → Environment Variables
#
# .env.local is git-ignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase — required
#    Dashboard → Project Settings → API (or "API Keys")
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Safe to expose; it is sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public anon (or sb_publishable_…) key.
# Safe to expose: Row Level Security restricts what anonymous visitors can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role (or sb_secret_…) key. SERVER ONLY.
# Bypasses Row Level Security, so it must never be prefixed with NEXT_PUBLIC_,
# imported into a client component, or committed to git.
# Used for: reading site settings, admin panel operations, the panel API and
# newsletter signups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# 2. Public site URL — strongly recommended
#
# No trailing slash. Used for:
#   • auth email redirects (email confirmation, password reset)
#   • the API endpoint shown on /api/docs
#
# Local:      http://localhost:3000
# Production: https://your-domain.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
